{
  "fail_on": "high",
  "format": "text",
  "globs": ["skills/**/SKILL.md", "contexts/**/*.md", "tools/**/*"],
  // These exclude patterns are used to ignore files and directories 
  // that are not relevant for the skill discovery process. 
  // You can modify this list based on your project's structure and requirements.
  "exclude": [
    "node_modules",
    "dist",
    "dist-test",
    ".git",
    ".github",
    "examples",
    "scripts",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "experiments",
    "docs"
  ],
  "skill_discovery": {
    "adopted": true
  },
  "metadata": {
    "required": ["owner"]
  }
}
