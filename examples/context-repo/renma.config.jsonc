{
  "fail_on": "high",
  "diagnostics": {
    "ci_policy": "fail",
    "severity": {
      "META-REQUIRED-SUSPENDED-DEPENDENCY": "high"
    }
  },
  "format": "text",
  "globs": [
    "skills/**/SKILL.md",
    "contexts/**/*.md",
    "lenses/**/*.md",
    "tools/**/*",
    "README.md"
  ],
  "exclude": ["node_modules", "dist", ".git"]
}
