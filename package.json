{
  "name": "renma",
  "version": "0.28.1",
  "description": "Manage human-curated context assets for LLMs and agents in Git.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KazuCocoa/renma.git"
  },
  "bugs": {
    "url": "https://github.com/KazuCocoa/renma/issues"
  },
  "homepage": "https://github.com/KazuCocoa/renma#readme",
  "keywords": [
    "context-repository",
    "context-engineering",
    "llm",
    "ai-agents",
    "knowledge-management",
    "developer-tools",
    "cli"
  ],
  "type": "module",
  "bin": {
    "renma": "./dist/index.js"
  },
  "exports": {
    "./package.json": "./package.json",
    "./dist/types.js": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./dist/types/artifact.js": {
      "types": "./dist/types/artifact.d.ts",
      "import": "./dist/types/artifact.js",
      "default": "./dist/types/artifact.js"
    },
    "./dist/types/classification.js": {
      "types": "./dist/types/classification.d.ts",
      "import": "./dist/types/classification.js",
      "default": "./dist/types/classification.js"
    },
    "./dist/types/configuration.js": {
      "types": "./dist/types/configuration.d.ts",
      "import": "./dist/types/configuration.js",
      "default": "./dist/types/configuration.js"
    },
    "./dist/types/decision.js": {
      "types": "./dist/types/decision.d.ts",
      "import": "./dist/types/decision.js",
      "default": "./dist/types/decision.js"
    },
    "./dist/types/diagnostics.js": {
      "types": "./dist/types/diagnostics.d.ts",
      "import": "./dist/types/diagnostics.js",
      "default": "./dist/types/diagnostics.js"
    },
    "./dist/types/governance.js": {
      "types": "./dist/types/governance.d.ts",
      "import": "./dist/types/governance.js",
      "default": "./dist/types/governance.js"
    },
    "./dist/types/metadata.js": {
      "types": "./dist/types/metadata.d.ts",
      "import": "./dist/types/metadata.js",
      "default": "./dist/types/metadata.js"
    },
    "./dist/types/scan-result.js": {
      "types": "./dist/types/scan-result.d.ts",
      "import": "./dist/types/scan-result.js",
      "default": "./dist/types/scan-result.js"
    },
    "./dist/discovery.js": {
      "types": "./dist/discovery.d.ts",
      "import": "./dist/discovery.js",
      "default": "./dist/discovery.js"
    },
    "./dist/commands/inspect.js": {
      "types": "./dist/commands/inspect.d.ts",
      "import": "./dist/commands/inspect.js",
      "default": "./dist/commands/inspect.js"
    },
    "./dist/commands/skill-index.js": {
      "types": "./dist/commands/skill-index.d.ts",
      "import": "./dist/commands/skill-index.js",
      "default": "./dist/commands/skill-index.js"
    },
    "./dist/commands/guide.js": {
      "types": "./dist/commands/guide.d.ts",
      "import": "./dist/commands/guide.js",
      "default": "./dist/commands/guide.js"
    },
    "./dist/guidance/skill-authoring.js": {
      "types": "./dist/guidance/skill-authoring.d.ts",
      "import": "./dist/guidance/skill-authoring.js",
      "default": "./dist/guidance/skill-authoring.js"
    },
    "./dist/renderers/guide.js": {
      "types": "./dist/renderers/guide.d.ts",
      "import": "./dist/renderers/guide.js",
      "default": "./dist/renderers/guide.js"
    },
    "./dist/commands/suggest-metadata.js": {
      "types": "./dist/commands/suggest-metadata.d.ts",
      "import": "./dist/commands/suggest-metadata.js",
      "default": "./dist/commands/suggest-metadata.js"
    },
    "./dist/skill-migration.js": {
      "types": "./dist/skill-migration.d.ts",
      "import": "./dist/skill-migration.js",
      "default": "./dist/skill-migration.js"
    }
  },
  "files": [
    "dist",
    "scripts",
    "docs",
    "architecture.md",
    "design.md",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "clean": "node -e \"const fs=require('node:fs'); for (const dir of ['dist','dist-test']) fs.rmSync(dir,{recursive:true,force:true});\"",
    "clean:test": "node -e \"require('node:fs').rmSync('dist-test',{recursive:true,force:true});\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "npm run clean:test && tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "format": "prettier --write \"**/*.{ts,js,mjs,json}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,json}\"",
    "lint": "eslint \"{src,test}/**/*.ts\" \"{scripts,tools}/**/*.mjs\" \"eslint.config.js\"",
    "lint:fix": "eslint --fix \"{src,test}/**/*.ts\" \"{scripts,tools}/**/*.mjs\" \"eslint.config.js\"",
    "verify:package": "npm run build && node scripts/verify-package.mjs",
    "split-reference": "node scripts/split-reference.mjs",
    "suggest-semantic-split": "node dist/index.js suggest-semantic-split"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.15.30",
    "@types/unist": "^3.0.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "^4.9.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.61.0"
  },
  "dependencies": {
    "mdast-util-from-markdown": "^2.0.3",
    "tldts": "7.4.9",
    "yaml": "^2.9.0"
  }
}
